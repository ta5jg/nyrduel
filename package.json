{
  "name": "nyrduel",
  "version": "0.1.0",
  "private": true,
  "description": "Daily Duel — a Wordle-style 60-second 1v1 dueling game. Everyone fights the same AI today; best score wins.",
  "license": "MIT",
  "author": "ta5jg <irfangedik@gmail.com>",
  "homepage": "https://github.com/ta5jg/nyrduel",
  "repository": {
    "type": "git",
    "url": "https://github.com/ta5jg/nyrduel.git"
  },
  "type": "module",
  "scripts": {
    "dev": "pnpm -r --parallel --filter \"./apps/*\" --filter \"./services/*\" run dev",
    "dev:web": "pnpm --filter @nyrduel/web dev",
    "dev:gateway": "pnpm --filter @nyrduel/gateway dev",
    "build": "pnpm -r run build",
    "typecheck": "pnpm -r run typecheck",
    "test": "pnpm -r run test",
    "lint": "pnpm -r run lint",
    "format": "prettier --write \"**/*.{ts,tsx,json,md,css,html}\""
  },
  "devDependencies": {
    "prettier": "^3.4.2",
    "typescript": "^5.6.3"
  },
  "engines": {
    "node": ">=20",
    "pnpm": ">=9"
  },
  "packageManager": "pnpm@9.15.0"
}
