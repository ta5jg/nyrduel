{
  "name": "@nyrduel/engine",
  "version": "0.1.0",
  "private": true,
  "description": "Deterministic 1v1 battle engine, hero/ability definitions, scoring, and daily seed helpers.",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
